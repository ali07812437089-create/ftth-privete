import puppeteer from "@cloudflare/puppeteer";
const VERSION='karrar-ftth-cloud-1.0.13';
const FTTH_BASE='https://admin.ftth.iq/api';
const FTTH_CLIENT='53d57a7f-3f89-4e9d-873b-3d071bc6dd9f';
const enc=new TextEncoder();const dec=new TextDecoder();let initPromise;let ftthRefreshPromise=null;
const cp1252Reverse=new Map([['€',0x80],['‚',0x82],['ƒ',0x83],['„',0x84],['…',0x85],['†',0x86],['‡',0x87],['ˆ',0x88],['‰',0x89],['Š',0x8a],['‹',0x8b],['Œ',0x8c],['Ž',0x8e],['‘',0x91],['’',0x92],['“',0x93],['”',0x94],['•',0x95],['–',0x96],['—',0x97],['˜',0x98],['™',0x99],['š',0x9a],['›',0x9b],['œ',0x9c],['ž',0x9e],['Ÿ',0x9f]]);
function legacyByte(c){const cp=c.codePointAt(0);return cp<=0xff?cp:(cp1252Reverse.get(c)??null)}
function decodeLegacyUtf8(part){const bytes=[];for(const c of part){const n=legacyByte(c);if(n===null)return null;bytes.push(n)}try{return new TextDecoder('utf-8',{fatal:true}).decode(Uint8Array.from(bytes))}catch{return null}}
function mojibakeScore(x){return (x.match(/[ØÙÃÂ]/g)||[]).length*3+(x.match(/[\u0080-\u009f]/g)||[]).length+(x.match(/[„…‚ƒˆ‰Š‹ŒŽ‘’“”•–—˜™š›œžŸ]/g)||[]).length}
function repairArabic(v){if(typeof v!=='string'||!/[ØÙÃÂ]/.test(v))return v;return v.replace(/[\u0000-\u00ff\u0152\u0153\u0160\u0161\u0178\u017d\u017e\u0192\u02c6\u02dc\u2010-\u203a\u20ac\u2122]+/g,part=>{if(!/[ØÙÃÂ]/.test(part))return part;let out=part;for(let pass=0;pass<3;pass++){if(!/[ØÙÃÂ]/.test(out))break;const candidate=decodeLegacyUtf8(out);if(!candidate)break;const hasArabic=/[\u0600-\u06ff]/.test(candidate);if(!hasArabic&&mojibakeScore(candidate)>=mojibakeScore(out))break;out=candidate}return out})}
const now=()=>new Date().toISOString();
const clean=(v,n=300)=>v==null?'':repairArabic(String(v)).trim().slice(0,n);
const digits=v=>String(v||'').replace(/\D/g,'');
const b64u=b=>{let s='';for(const x of b)s+=String.fromCharCode(x);return btoa(s).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'')};
const ub64=s=>{s=String(s||'').replace(/-/g,'+').replace(/_/g,'/');while(s.length%4)s+='=';const a=atob(s),u=new Uint8Array(a.length);for(let i=0;i<a.length;i++)u[i]=a.charCodeAt(i);return u};
const hex=u=>[...u].map(x=>x.toString(16).padStart(2,'0')).join('');
async function sha(s){return hex(new Uint8Array(await crypto.subtle.digest('SHA-256',enc.encode(String(s||'')))))}
function json(data,status=200,headers={}){return new Response(JSON.stringify(data),{status,headers:{'content-type':'application/json; charset=utf-8','cache-control':'no-store','x-content-type-options':'nosniff',...headers}})}
async function body(req,max=1024*1024){const ab=await req.arrayBuffer();if(ab.byteLength>max)throw Error('Body too large');const b=new Uint8Array(ab);let txt='';if(b.length>=2&&b[0]===0xff&&b[1]===0xfe){txt=new TextDecoder('utf-16le').decode(b.subarray(2))}else if(b.length>=2&&b[0]===0xfe&&b[1]===0xff){throw Error('UTF-16BE request body is not supported')}else if(b.length>=4&&b[1]===0&&b[3]===0){txt=new TextDecoder('utf-16le').decode(b)}else{txt=dec.decode(b)}txt=txt.replace(/^\uFEFF/,'').replace(/\u0000/g,'').trim();let v;try{v=JSON.parse(txt||'{}')}catch(e){throw Error('Invalid JSON request body: '+String(e?.message||e))}if(!v||Array.isArray(v)||typeof v!=='object')throw Error('Invalid JSON');return v}
function cookie(req,name){return (req.headers.get('cookie')||'').split(';').map(x=>x.trim()).find(x=>x.startsWith(name+'='))?.slice(name.length+1)||''}
function withCookie(res,name,val,age,same='Strict'){const h=new Headers(res.headers);h.append('Set-Cookie',`${name}=${val}; HttpOnly; Secure; SameSite=${same}; Path=/; Max-Age=${age}`);return new Response(res.body,{status:res.status,headers:h})}
async function init(env){if(initPromise)return initPromise;initPromise=env.DB.batch([
 env.DB.prepare('CREATE TABLE IF NOT EXISTS k_settings(key TEXT PRIMARY KEY,value TEXT NOT NULL,updated_at TEXT NOT NULL)'),
 env.DB.prepare('CREATE TABLE IF NOT EXISTS k_subscribers(id TEXT PRIMARY KEY,customer_name TEXT,username TEXT,zone TEXT,fdt TEXT,fat TEXT,fdt_id TEXT,fat_id TEXT,status TEXT,expires TEXT,online INTEGER,rx_power REAL,rx_power_checked_at TEXT,customer_id TEXT,subscription_id TEXT,serial TEXT,ont_vendor TEXT,point_supply_number TEXT,phone TEXT,phone2 TEXT,ip_address TEXT,mac_address TEXT,started_at TEXT,bundle TEXT,source_updated_at TEXT,raw_json TEXT)'),
 env.DB.prepare('CREATE INDEX IF NOT EXISTS k_subs_name ON k_subscribers(customer_name)'),env.DB.prepare('CREATE INDEX IF NOT EXISTS k_subs_user ON k_subscribers(username)'),env.DB.prepare('CREATE INDEX IF NOT EXISTS k_subs_serial ON k_subscribers(serial)'),env.DB.prepare('CREATE INDEX IF NOT EXISTS k_subs_phone ON k_subscribers(phone)'),
 env.DB.prepare('CREATE TABLE IF NOT EXISTS k_users(id TEXT PRIMARY KEY,name TEXT NOT NULL,username TEXT UNIQUE NOT NULL,salt TEXT NOT NULL,digest TEXT NOT NULL,role TEXT NOT NULL,status TEXT NOT NULL,permissions_json TEXT NOT NULL,start_time TEXT NOT NULL,end_time TEXT NOT NULL,devices_json TEXT NOT NULL)'),
 env.DB.prepare('CREATE TABLE IF NOT EXISTS k_sessions(token_hash TEXT PRIMARY KEY,user_id TEXT NOT NULL,device_id TEXT,expires_at INTEGER NOT NULL)'),
 env.DB.prepare('CREATE TABLE IF NOT EXISTS k_audit(id TEXT PRIMARY KEY,at TEXT NOT NULL,user_id TEXT,name TEXT,action TEXT NOT NULL,detail_json TEXT)'),
 env.DB.prepare('CREATE TABLE IF NOT EXISTS k_chat(id TEXT PRIMARY KEY,scope TEXT NOT NULL,user_id TEXT NOT NULL,user_name TEXT,question TEXT NOT NULL,answer TEXT NOT NULL,provider TEXT NOT NULL,created_at TEXT NOT NULL)'),
 env.DB.prepare('CREATE INDEX IF NOT EXISTS k_chat_scope ON k_chat(scope,created_at)'),
 env.DB.prepare('CREATE TABLE IF NOT EXISTS k_portal_accounts(subscriber_key TEXT PRIMARY KEY,phone TEXT NOT NULL,salt TEXT NOT NULL,digest TEXT NOT NULL,enabled INTEGER NOT NULL,updated_at TEXT NOT NULL)'),
 env.DB.prepare('CREATE TABLE IF NOT EXISTS k_portal_sessions(token_hash TEXT PRIMARY KEY,subscriber_key TEXT NOT NULL,expires_at INTEGER NOT NULL)'),
 env.DB.prepare('CREATE TABLE IF NOT EXISTS k_customer_tickets(customer_id TEXT PRIMARY KEY,payload_json TEXT NOT NULL,updated_at TEXT NOT NULL)'),
 env.DB.prepare('CREATE TABLE IF NOT EXISTS ftth_settings(key TEXT PRIMARY KEY,value TEXT NOT NULL)')
 ]).then(()=>true);return initPromise}
async function getSet(env,key,def=null){const r=await env.DB.prepare('SELECT value FROM k_settings WHERE key=?').bind(key).first();if(!r)return def;try{return JSON.parse(r.value)}catch{return r.value}}
async function setSet(env,key,value){const s=typeof value==='string'?value:JSON.stringify(value);await env.DB.prepare('INSERT INTO k_settings(key,value,updated_at) VALUES(?,?,?) ON CONFLICT(key) DO UPDATE SET value=excluded.value,updated_at=excluded.updated_at').bind(key,s,now()).run();return value}
async function audit(env,user,action,detail={}){await env.DB.prepare('INSERT INTO k_audit(id,at,user_id,name,action,detail_json) VALUES(?,?,?,?,?,?)').bind(crypto.randomUUID(),now(),user?.id||'anonymous',clean(user?.name,120),action,JSON.stringify(detail)).run()}
async function pbkdf(password,saltHex){const key=await crypto.subtle.importKey('raw',enc.encode(password),'PBKDF2',false,['deriveBits']);const bits=await crypto.subtle.deriveBits({name:'PBKDF2',hash:'SHA-256',salt:ub64(saltHex),iterations:120000},key,256);return hex(new Uint8Array(bits))}
async function makePass(password){const salt=crypto.getRandomValues(new Uint8Array(16));return {salt:b64u(salt),digest:await pbkdf(password,b64u(salt))}}
async function verifyPass(password,salt,digest){return !!digest&&await pbkdf(String(password||''),salt)===digest}
async function adminRecord(env){return await getSet(env,'admin_password',null)}
async function verifyAdmin(env,p){const rec=await adminRecord(env);if(rec?.salt&&rec?.digest)return verifyPass(p,rec.salt,rec.digest);return !!env.KARRAR_ADMIN_PASSWORD&&await sha(p)===await sha(env.KARRAR_ADMIN_PASSWORD)}
async function setAdminPassword(env,p,actor){p=String(p||'');if(p.length<5||p.length>128)throw Error('الباسورد لازم يكون بين 5 و128 حرف.');const r=await makePass(p);await setSet(env,'admin_password',{...r,updatedAt:now(),updatedBy:actor?.id||'system'});await audit(env,actor,'admin.password.changed',{});return {ok:true}}
const adminUser={id:'admin',name:'مدير النظام',username:'admin',role:'admin',status:'approved',permissions:['zones','fats','subscribers','finance','manageSubscriber','maintenance','reports','ai'],start:'00:00',end:'00:00'};
async function sessionUser(req,env){const raw=cookie(req,'ftth_session');if(!raw)return null;const h=await sha(raw);const s=await env.DB.prepare('SELECT * FROM k_sessions WHERE token_hash=?').bind(h).first();if(!s||s.expires_at<Date.now()){if(s)await env.DB.prepare('DELETE FROM k_sessions WHERE token_hash=?').bind(h).run();return null}if(s.user_id==='admin')return {u:adminUser,device:null};const u=await env.DB.prepare('SELECT * FROM k_users WHERE id=?').bind(s.user_id).first();if(!u)return null;const devices=JSON.parse(u.devices_json||'[]');const dev=devices.find(x=>x.id===s.device_id)||null;return {u:{id:u.id,name:u.name,username:u.username,role:u.role,status:u.status,permissions:JSON.parse(u.permissions_json||'[]'),start:u.start_time,end:u.end_time,devices},device:dev}}
function inHours(u){if(u.role==='admin'||u.start===u.end)return true;const parts=new Intl.DateTimeFormat('en-GB',{timeZone:'Asia/Baghdad',hour:'2-digit',minute:'2-digit',hourCycle:'h23'}).format(new Date());return u.start<u.end?parts>=u.start&&parts<u.end:parts>=u.start||parts<u.end}
function allowed(st){return !!st&&(st.u.role==='admin'||(st.u.status==='approved'&&st.device?.status==='approved'&&inHours(st.u)))}
function permit(st,p){return allowed(st)&&(st.u.role==='admin'||st.u.permissions.includes(p))}
async function createSession(env,userId,deviceId=null){const raw=b64u(crypto.getRandomValues(new Uint8Array(32)));await env.DB.prepare('INSERT INTO k_sessions(token_hash,user_id,device_id,expires_at) VALUES(?,?,?,?)').bind(await sha(raw),userId,deviceId,Date.now()+8*3600e3).run();return raw}
async function authRoute(req,env,url){if(url.pathname==='/api/me'&&req.method==='GET'){const st=await sessionUser(req,env);return json({user:st?{id:st.u.id,name:st.u.name,username:st.u.username,role:st.u.role,status:st.u.status,permissions:st.u.permissions,start:st.u.start,end:st.u.end,deviceStatus:st.device?.status,access:allowed(st)}:null,localOnly:false,cloud:true})}
 if(!url.pathname.startsWith('/api/auth/'))return null;
 if(req.method!=='POST')return json({error:'Method not allowed'},405);const b=await body(req);
 if(url.pathname==='/api/auth/logout'){const raw=cookie(req,'ftth_session');if(raw)await env.DB.prepare('DELETE FROM k_sessions WHERE token_hash=?').bind(await sha(raw)).run();return withCookie(json({ok:true}),'ftth_session','',0)}
 if(url.pathname==='/api/auth/admin'){if(!(await verifyAdmin(env,b.code)))return json({error:'Invalid sign-in'},401);const token=await createSession(env,'admin');await audit(env,adminUser,'login',{cloud:true});return withCookie(json({ok:true}),'ftth_session',token,28800)}
 const username=clean(b.username,40).toLowerCase(),password=String(b.password||'');if(!/^[a-z0-9_.-]{3,40}$/.test(username)||password.length<12||password.length>128)return json({error:'Use a username of 3–40 letters/numbers and a password of 12–128 characters.'},400);
 if(url.pathname==='/api/auth/register'){if(clean(b.name,120).length<3)return json({error:'Invalid name'},400);if(await env.DB.prepare('SELECT id FROM k_users WHERE username=?').bind(username).first())return json({error:'Unable to register'},400);const hp=await makePass(password),id=crypto.randomUUID(),deviceRaw=b64u(crypto.getRandomValues(new Uint8Array(32))),device={id:crypto.randomUUID(),hash:await sha(deviceRaw),label:clean(req.headers.get('user-agent'),180),status:'pending',createdAt:now()};await env.DB.prepare('INSERT INTO k_users(id,name,username,salt,digest,role,status,permissions_json,start_time,end_time,devices_json) VALUES(?,?,?,?,?,?,?,?,?,?,?)').bind(id,clean(b.name,120),username,hp.salt,hp.digest,'staff','pending','[]','09:00','13:00',JSON.stringify([device])).run();const token=await createSession(env,id,device.id);let r=json({ok:true},201);r=withCookie(r,'ftth_device',deviceRaw,2592000);return withCookie(r,'ftth_session',token,28800)}
 if(url.pathname==='/api/auth/login'){const u=await env.DB.prepare('SELECT * FROM k_users WHERE username=?').bind(username).first();if(!u||!(await verifyPass(password,u.salt,u.digest)))return json({error:'Invalid sign-in'},401);let devices=JSON.parse(u.devices_json||'[]'),rawDev=cookie(req,'ftth_device'),h=rawDev?await sha(rawDev):'',device=devices.find(x=>x.hash===h);let res;if(!device){rawDev=b64u(crypto.getRandomValues(new Uint8Array(32)));device={id:crypto.randomUUID(),hash:await sha(rawDev),label:clean(req.headers.get('user-agent'),180),status:'pending',createdAt:now()};devices.push(device);await env.DB.prepare('UPDATE k_users SET devices_json=? WHERE id=?').bind(JSON.stringify(devices.slice(-20)),u.id).run();res=withCookie(json({ok:true}),'ftth_device',rawDev,2592000)}else res=json({ok:true});const token=await createSession(env,u.id,device.id);return withCookie(res,'ftth_session',token,28800)}
 return json({error:'Not found'},404)}
async function adminRoute(req,env,url,st){if(!url.pathname.startsWith('/api/admin/'))return null;if(st?.u.role!=='admin')return json({error:'Administrator required'},403);
 if(url.pathname==='/api/admin/users'&&req.method==='GET'){const rows=(await env.DB.prepare('SELECT * FROM k_users ORDER BY name').all()).results||[];return json({users:rows.map(u=>({id:u.id,name:u.name,username:u.username,role:u.role,status:u.status,permissions:JSON.parse(u.permissions_json||'[]'),start:u.start_time,end:u.end_time,devices:JSON.parse(u.devices_json||'[]').map(({hash,...d})=>d)}))})}
 if(url.pathname==='/api/admin/audit'&&req.method==='GET'){const rows=(await env.DB.prepare('SELECT * FROM k_audit ORDER BY at DESC LIMIT 200').all()).results||[];return json({events:rows.map(r=>({id:r.id,at:r.at,userId:r.user_id,name:r.name,action:r.action,...JSON.parse(r.detail_json||'{}')})).filter(x=>url.searchParams.get('type')!=='chat'||x.action==='chat')})}
 if(url.pathname==='/api/admin/inbox'&&req.method==='GET'){const rows=(await env.DB.prepare('SELECT status,devices_json FROM k_users').all()).results||[];return json({pending:rows.filter(u=>u.status==='pending'||JSON.parse(u.devices_json||'[]').some(d=>d.status==='pending')).length,chats:0})}
 if(url.pathname==='/api/admin/user'&&req.method==='POST'){const b=await body(req),u=await env.DB.prepare('SELECT * FROM k_users WHERE id=?').bind(b.id).first();if(!u)return json({error:'User not found'},404);let devices=JSON.parse(u.devices_json||'[]');if(b.deviceId){const d=devices.find(x=>x.id===b.deviceId);if(d&&['approved','pending','suspended'].includes(b.deviceStatus))d.status=b.deviceStatus}const permissions=Array.isArray(b.permissions)?b.permissions.filter(x=>['zones','fats','subscribers','finance','manageSubscriber','maintenance','reports','ai'].includes(x)):JSON.parse(u.permissions_json||'[]');await env.DB.prepare('UPDATE k_users SET status=?,permissions_json=?,start_time=?,end_time=?,devices_json=? WHERE id=?').bind(['approved','pending','suspended'].includes(b.status)?b.status:u.status,JSON.stringify(permissions),/^([01]\d|2[0-3]):[0-5]\d$/.test(b.start||'')?b.start:u.start_time,/^([01]\d|2[0-3]):[0-5]\d$/.test(b.end||'')?b.end:u.end_time,JSON.stringify(devices),u.id).run();return json({ok:true})}
 return json({error:'Not found'},404)}
async function aesKey(env){const secret=env.KARRAR_TOKEN_KEY||env.FTTH_BRIDGE_KEY;if(!secret)throw Error('KARRAR_TOKEN_KEY_REQUIRED');const d=await crypto.subtle.digest('SHA-256',enc.encode(secret));return crypto.subtle.importKey('raw',d,{name:'AES-GCM'},false,['encrypt','decrypt'])}
async function seal(env,obj){const iv=crypto.getRandomValues(new Uint8Array(12)),key=await aesKey(env),ct=new Uint8Array(await crypto.subtle.encrypt({name:'AES-GCM',iv},key,enc.encode(JSON.stringify(obj))));return 'v1.'+b64u(iv)+'.'+b64u(ct)}
async function openSeal(env,s){if(!s||!s.startsWith('v1.'))return null;try{const [,a,b]=s.split('.'),key=await aesKey(env),pt=await crypto.subtle.decrypt({name:'AES-GCM',iv:ub64(a)},key,ub64(b));return JSON.parse(dec.decode(pt))}catch{return null}}
function jwtPayload(t){try{return JSON.parse(dec.decode(ub64(String(t).split('.')[1])))}catch{return {}}}
async function getTokenState(env){const s=await getSet(env,'ftth_token',null);return typeof s==='string'?await openSeal(env,s):null}
async function saveTokenState(env,t){await setSet(env,'ftth_token',await seal(env,t));return t}
async function browserRefreshFtth(env,refreshToken){
 if(!env.BROWSER)return null;
 let browser=null;
 try{
  browser=await puppeteer.launch(env.BROWSER);
  const page=await browser.newPage();
  await page.setExtraHTTPHeaders({'accept-language':'en-US,en;q=0.9,ar;q=0.8'}).catch(()=>{});
  // Load a same-origin resource first so the refresh request is sent from a normal admin.ftth.iq browser context.
  await page.goto('https://admin.ftth.iq/favicon.ico',{waitUntil:'domcontentloaded',timeout:15000}).catch(()=>{});
  let result=await page.evaluate(async ({refreshToken,client})=>{
   const parse=async r=>{const tx=await r.text().catch(()=>'');let d=null;try{d=JSON.parse(tx||'{}')}catch{}return {status:r.status,ok:r.ok,d,tx:tx.slice(0,500)}};
   const form=new URLSearchParams({grant_type:'refresh_token',scope:'openid profile',refresh_token:refreshToken});
   try{
    const r=await fetch('https://admin.ftth.iq/api/auth/Contractor/token',{method:'POST',headers:{'content-type':'application/x-www-form-urlencoded','accept':'application/json, text/plain, */*','x-client-app':client,'x-user-role':'0'},body:form.toString(),cache:'no-store',credentials:'include'});
    const out=await parse(r);if(out.ok&&out.d?.access_token)return out;
   }catch(e){}
   const form2=new URLSearchParams({grant_type:'refresh_token',client_id:'earthlink-portals',refresh_token:refreshToken});
   try{
    const r=await fetch('https://sso.ftth.iq/auth/realms/Partners/protocol/openid-connect/token',{method:'POST',headers:{'content-type':'application/x-www-form-urlencoded','accept':'application/json, text/plain, */*'},body:form2.toString(),cache:'no-store',credentials:'omit'});
    return await parse(r);
   }catch(e){return {status:0,ok:false,d:null,tx:String(e?.message||e).slice(0,500)}}
  },{refreshToken,client:FTTH_CLIENT});
  return result;
 }catch(e){return {status:0,ok:false,d:null,tx:'browser:'+clean(e?.message||e,300)}}
 finally{if(browser)await browser.close().catch(()=>{})}
}
async function refreshFtth(env,force=false){
 const current=await getTokenState(env),accessOk=!!current?.access&&Number(current.accessExp||0)>Date.now()+120000;
 if(!force&&accessOk)return current;
 if(ftthRefreshPromise)return ftthRefreshPromise;
 ftthRefreshPromise=(async()=>{
  let t=await getTokenState(env),ok=!!t?.access&&Number(t.accessExp||0)>Date.now()+120000;
  if(!force&&ok)return t;
  if(!t?.refresh)throw Object.assign(new Error('رمز تجديد FTTH غير موجود بالسحابة.'),{status:401,code:'FTTH_REFRESH_MISSING'});
  if(Number(t.refreshExp||0)>0&&Number(t.refreshExp)<=Date.now())throw Object.assign(new Error('انتهت جلسة FTTH الرئيسية وتحتاج تسجيل دخول جديد مرة واحدة.'),{status:401,code:'FTTH_REFRESH_EXPIRED'});
  const parse=async r=>{const tx=await r.text().catch(()=>'');let d=null;try{d=JSON.parse(tx||'{}')}catch{}return {r,d,tx}};
  const adminForm=new URLSearchParams({grant_type:'refresh_token',scope:'openid profile',refresh_token:t.refresh});
  let attempt=await parse(await fetch(FTTH_BASE+'/auth/Contractor/token',{method:'POST',headers:{'content-type':'application/x-www-form-urlencoded','accept':'application/json','x-client-app':FTTH_CLIENT,'x-user-role':'0'},body:adminForm,cache:'no-store',signal:AbortSignal.timeout(25000)}));
  if(!attempt.r.ok||!attempt.d?.access_token){
   const directForm=new URLSearchParams({grant_type:'refresh_token',client_id:'earthlink-portals',refresh_token:t.refresh});
   try{
    const direct=await parse(await fetch('https://sso.ftth.iq/auth/realms/Partners/protocol/openid-connect/token',{method:'POST',headers:{'content-type':'application/x-www-form-urlencoded','accept':'application/json'},body:directForm,cache:'no-store',signal:AbortSignal.timeout(25000)}));
    if(direct.r.ok&&direct.d?.access_token)attempt=direct;
    else if(attempt.r.status>=500)attempt=direct;
   }catch{}
  }
  if((!attempt.r.ok||!attempt.d?.access_token)&&env.BROWSER){
   const br=await browserRefreshFtth(env,t.refresh);
   if(br?.ok&&br?.d?.access_token){attempt={r:{ok:true,status:br.status||200},d:br.d,tx:br.tx||''};}
   else if(br?.status){attempt={r:{ok:false,status:br.status},d:br?.d||null,tx:br?.tx||''};}
  }
  const r=attempt.r,d=attempt.d;
  if(!r.ok||!d?.access_token){const detail=clean(d?.error_description||d?.error||attempt.tx||'',180);throw Object.assign(new Error(`تعذر تجديد جلسة FTTH (${r.status||502})${detail?`: ${detail}`:''}`),{status:r.status||502,code:'FTTH_REFRESH_FAILED'});}
  const nextRefresh=d.refresh_token||t.refresh,ap=jwtPayload(d.access_token),rp=jwtPayload(nextRefresh);
  t={...t,access:d.access_token,refresh:nextRefresh,accessExp:(ap.exp?ap.exp*1000:Date.now()+Number(d.expires_in||3600)*1000),refreshExp:(rp.exp?rp.exp*1000:(Number(d.refresh_expires_in||0)>0?Date.now()+Number(d.refresh_expires_in)*1000:Number(t.refreshExp||0))),lastRefreshAt:now(),source:'refresh'};
  await saveTokenState(env,t);
  return t;
 })().finally(()=>{ftthRefreshPromise=null});
 return ftthRefreshPromise;
}
async function ftthFetch(env,path,opt={}){
 let t=await refreshFtth(env);
 const run=async()=>{
  const h={'accept':'application/json, text/plain, */*','accept-language':'ar,en-US;q=0.9,en;q=0.8','authorization':'Bearer '+t.access,'referer':'https://admin.ftth.iq/','x-client-app':FTTH_CLIENT,'x-user-role':'0','cache-control':'no-cache'};
  let bodyv;if(opt.json){h['content-type']='application/json';h['origin']='https://admin.ftth.iq';bodyv=JSON.stringify(opt.json)}
  const r=await fetch(FTTH_BASE+path,{method:opt.method||'GET',headers:h,cache:'no-store',body:bodyv,signal:AbortSignal.timeout(opt.timeout||25000)});
  if(r.status===401)return {retry:true};
  if(!r.ok){const tx=await r.text().catch(()=>'');throw Object.assign(new Error(`FTTH رجع ${r.status}${tx?`: ${clean(tx,140)}`:''}`),{status:r.status});}
  if(r.status===204||r.headers.get('content-length')==='0')return null;
  const tx=await r.text();return tx?JSON.parse(tx):null;
 };
 let out=await run();
 if(out?.retry){t=await refreshFtth(env,true);out=await run();if(out?.retry)throw Object.assign(new Error('جلسة FTTH مرفوضة بعد التجديد.'),{status:401});}
 return out;
}
function tokenStatus(t){const n=Date.now(),hasAccess=!!t?.access,hasRefresh=!!t?.refresh;return {configured:hasAccess||hasRefresh,stored:hasAccess||hasRefresh,autoRefresh:hasRefresh,browserSync:t?.source==='browser'||!!t?.lastBrowserSyncAt,expiresAt:t?.accessExp?new Date(t.accessExp).toISOString():null,refreshExpiresAt:t?.refreshExp?new Date(t.refreshExp).toISOString():null,expired:!!t?.accessExp&&t.accessExp<=n,refreshExpired:!!t?.refreshExp&&t.refreshExp<=n,lastRefreshAt:t?.lastRefreshAt||null,lastBrowserSyncAt:t?.lastBrowserSyncAt||null}}
async function accessTokenSync(req,env){
 const key=req.headers.get('x-karrar-sync-key')||'';
 if(!env.FTTH_TOKEN_SYNC_KEY||await sha(key)!==await sha(env.FTTH_TOKEN_SYNC_KEY))return json({error:'Unauthorized'},401);
 const x=await body(req,64*1024),access=String(x.accessToken||'').replace(/^Bearer\s+/i,'').trim(),refresh=String(x.refreshToken||'').replace(/^Bearer\s+/i,'').trim();
 const valid=(token,kind)=>{if(!token||token.length<80||token.split('.').length!==3)return null;const p=jwtPayload(token),iss=String(p.iss||''),exp=Number(p.exp||0),typ=String(p.typ||'').toLowerCase();if(!iss.startsWith('https://sso.ftth.iq/')||!exp||exp*1000<=Date.now()+5000)return null;if(kind==='access'&&typ&&typ!=='bearer')return null;if(kind==='refresh'&&typ&&typ==='bearer')return null;return {token,p,exp:exp*1000}};
 const a=valid(access,'access'),r=valid(refresh,'refresh');
 if(!a&&!r)return json({error:'No valid FTTH token bundle found'},400);
 const old=await getTokenState(env)||{},t={...old,lastBrowserSyncAt:now(),source:r?'browser-refresh':'browser'};
 if(a){t.access=a.token;t.accessExp=a.exp}
 if(r){t.refresh=r.token;t.refreshExp=r.exp;t.lastRefreshAt=now()}
 await saveTokenState(env,t);
 return json({ok:true,accessUpdated:!!a,refreshUpdated:!!r,accessExp:t.accessExp?new Date(t.accessExp).toISOString():null,refreshExp:t.refreshExp?new Date(t.refreshExp).toISOString():null,autoRefresh:!!t.refresh,version:VERSION})
}
function customerPhones(c){const out=[],add=v=>{const d=digits(v);if(d.length>=10&&d.length<=15&&!out.includes(String(v||'').trim()))out.push(String(v).trim())};add(c?.primaryContact?.mobile);add(c?.secondaryContact?.mobile);add(c?.primaryContact?.phone);add(c?.secondaryContact?.phone);return out.slice(0,2)}
function normSub(x,extra={}){const d=x?.deviceDetails||{},id=clean(x?.self?.id||extra.customerId||crypto.randomUUID(),80);return {id,customerName:clean(x?.customer?.displayValue||extra.customerName,180),username:clean(d.username,120),zone:clean(x?.zone?.displayValue,120),fdt:clean(d.fdt?.displayValue,120),fat:clean(d.fat?.displayValue,120),fdtId:clean(d.fdt?.id,100),fatId:clean(d.fat?.id,100),status:clean(x?.status,80),expires:clean(x?.expires,80),hasActiveSession:typeof x?.hasActiveSession==='boolean'?x.hasActiveSession:null,rxPower:null,rxPowerCheckedAt:'',customerId:clean(x?.customer?.id||extra.customerId,80),subscriptionId:clean(x?.self?.id,80),serial:clean(d.serial,120),ontVendor:clean(d.ontVendor?.displayValue||d.ontVendor,120),pointSupplyNumber:clean(d.pointSupplyNumber?.displayValue??d.pointSupplyNumber,80),phone:clean(extra.phone,40),phone2:clean(extra.phone2,40),ipAddress:clean(x?.ipAddress||x?.activeSession?.ipAddress,80),macAddress:clean(x?.macAddress||x?.activeSession?.macAddress,80),startedAt:clean(x?.startedAt,80),bundle:clean(x?.bundle?.displayValue||x?.bundleId,120),sourceUpdatedAt:now(),raw:x}}
async function upsertSubs(env,items,extra={}){for(const raw of items||[]){const n=normSub(raw,extra),prev=await env.DB.prepare('SELECT phone,phone2,rx_power,rx_power_checked_at FROM k_subscribers WHERE id=?').bind(n.id).first();await env.DB.prepare(`INSERT INTO k_subscribers(id,customer_name,username,zone,fdt,fat,fdt_id,fat_id,status,expires,online,rx_power,rx_power_checked_at,customer_id,subscription_id,serial,ont_vendor,point_supply_number,phone,phone2,ip_address,mac_address,started_at,bundle,source_updated_at,raw_json) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?) ON CONFLICT(id) DO UPDATE SET customer_name=excluded.customer_name,username=excluded.username,zone=excluded.zone,fdt=excluded.fdt,fat=excluded.fat,fdt_id=excluded.fdt_id,fat_id=excluded.fat_id,status=excluded.status,expires=excluded.expires,online=excluded.online,customer_id=excluded.customer_id,subscription_id=excluded.subscription_id,serial=excluded.serial,ont_vendor=excluded.ont_vendor,point_supply_number=excluded.point_supply_number,phone=excluded.phone,phone2=excluded.phone2,ip_address=excluded.ip_address,mac_address=excluded.mac_address,started_at=excluded.started_at,bundle=excluded.bundle,source_updated_at=excluded.source_updated_at,raw_json=excluded.raw_json`).bind(n.id,n.customerName,n.username,n.zone,n.fdt,n.fat,n.fdtId,n.fatId,n.status,n.expires,n.hasActiveSession===null?null:(n.hasActiveSession?1:0),prev?.rx_power??null,prev?.rx_power_checked_at||'',n.customerId,n.subscriptionId,n.serial,n.ontVendor,n.pointSupplyNumber,n.phone||prev?.phone||'',n.phone2||prev?.phone2||'',n.ipAddress,n.macAddress,n.startedAt,n.bundle,n.sourceUpdatedAt,JSON.stringify(raw)).run()}}
function rowSub(r){return {id:r.id,customerName:clean(r.customer_name,180),username:clean(r.username,120),zone:clean(r.zone,120),fdt:clean(r.fdt,120),fat:clean(r.fat,120),fdtId:clean(r.fdt_id,100),fatId:clean(r.fat_id,100),status:clean(r.status,80),expires:clean(r.expires,80),hasActiveSession:r.online==null?null:!!r.online,rxPower:Number.isFinite(r.rx_power)?r.rx_power:null,rxPowerCheckedAt:r.rx_power_checked_at||'',customerId:r.customer_id||'',subscriptionId:r.subscription_id||'',serial:clean(r.serial,120),ontVendor:clean(r.ont_vendor,120),pointSupplyNumber:clean(r.point_supply_number,80),phone:clean(r.phone,40),phone2:clean(r.phone2,40),ipAddress:r.ip_address||'',macAddress:r.mac_address||'',startedAt:r.started_at||'',bundle:clean(r.bundle,120),sourceUpdatedAt:r.source_updated_at||''}}
async function allSubs(env,where='',bind=[]){const q='SELECT * FROM k_subscribers '+where;const r=await env.DB.prepare(q).bind(...bind).all();return (r.results||[]).map(rowSub)}
async function syncState(env){return await getSet(env,'sync',{fullState:'idle',fullNextPage:1,fullProcessedCustomers:0,fullFailedCustomers:0,fullTotalCustomers:0,fullTotalPages:0,fullStartedAt:null,fullLastSuccessAt:null,fullLastError:null,stopped:false})}
async function saveSync(env,s){await setSet(env,'sync',s);return s}
async function profileFromCurrent(env){const r=await ftthFetch(env,'/current-user'),m=r?.model||{},partner=m.partner||m.self||{};const p={username:clean(m.username,120),partnerId:clean(partner.id,80),partnerName:clean(partner.displayValue,180),zones:Array.isArray(m.zones)?m.zones.map(z=>clean(z?.displayValue||z?.id,120)).filter(Boolean):[]};await setSet(env,'profile',p);return p}
async function syncOnePage(env,{force=false}={}){let s=await syncState(env);if(s.stopped&&!force)return s;const last=Date.parse(s.fullLastSuccessAt||0);if(s.fullState==='complete'&&!force&&Date.now()-last<6*3600e3)return s;let page=s.fullState==='running'||s.fullState==='error'||s.fullState==='paused'?Number(s.fullNextPage||1):1;if(page===1){s={...s,fullState:'running',fullStartedAt:now(),fullProcessedCustomers:0,fullFailedCustomers:0,fullLastError:null,stopped:false};await profileFromCurrent(env)}try{const pageSize=25,customers=await ftthFetch(env,`/customers?pageSize=${pageSize}&pageNumber=${page}&sortCriteria.property=self.displayValue&sortCriteria.direction=asc`),list=Array.isArray(customers?.items)?customers.items:[],total=Number(customers?.totalCount||0),pages=Math.max(1,Math.ceil(total/pageSize));const results=await Promise.allSettled(list.map(async c=>{if(!c?.self?.id)return;const phones=customerPhones(c),subs=await ftthFetch(env,`/customers/subscriptions?customerId=${encodeURIComponent(c.self.id)}`);await upsertSubs(env,subs?.items||[],{customerId:c.self.id,customerName:c.self.displayValue,phone:phones[0]||'',phone2:phones[1]||''})}));const failed=results.filter(x=>x.status==='rejected').length;s={...s,fullState:page>=pages||list.length===0?'complete':'running',fullNextPage:page>=pages?1:page+1,fullProcessedCustomers:Number(s.fullProcessedCustomers||0)+list.length,fullFailedCustomers:Number(s.fullFailedCustomers||0)+failed,fullTotalCustomers:total,fullTotalPages:pages,fullLastError:null,fullLastRunAt:now()};if(s.fullState==='complete'){s.fullLastSuccessAt=now();await env.DB.prepare('DELETE FROM k_subscribers WHERE source_updated_at<?').bind(s.fullStartedAt||'1970-01-01').run()}await saveSync(env,s);return s}catch(e){s={...s,fullState:'error',fullLastError:clean(e.message,300),fullLastRunAt:now()};await saveSync(env,s);throw e}}
async function business(env){return await getSet(env,'business',{accounts:{},operations:[],tickets:[],notifications:[],cabinetLayouts:{},locations:{}})}
async function saveBusiness(env,b){await setSet(env,'business',b);return b}
function totals(a){let required=0,paid=0,discounts=0,balance=0,lastPayment=null;for(const e of a.entries||[]){balance+=Number(e.delta)||0;if(['charge','correction_plus'].includes(e.kind))required+=Math.max(0,Number(e.delta)||0);if(['payment','advance'].includes(e.kind)){paid+=Math.abs(Math.min(0,Number(e.delta)||0));lastPayment=e}if(['discount','correction_minus'].includes(e.kind))discounts+=Math.abs(Math.min(0,Number(e.delta)||0))}return {required,paid,discounts,balance,remaining:Math.max(0,balance),credit:Math.max(0,-balance),lastPayment}}
function accOf(b,key,name=''){key=clean(key,180);if(!b.accounts[key])b.accounts[key]={subscriberKey:key,customerName:clean(name,160),entries:[]};return b.accounts[key]}
function notifyPush(b,x){b.notifications.push({id:crypto.randomUUID(),at:now(),kind:x.kind||'info',title:clean(x.title,180),text:clean(x.text,1000),subscriberKey:clean(x.subscriberKey,180),customerName:clean(x.customerName,160),userId:x.user?.id||'',userName:clean(x.user?.name,120)});b.notifications=b.notifications.slice(-1000)}
async function tgSend(env,text,thread){if(!env.TELEGRAM_BOT_TOKEN||!env.FTTH_OWNER_ID)return;const payload={chat_id:env.FTTH_OWNER_ID,text};if(thread)payload.message_thread_id=Number(thread);await fetch(`https://api.telegram.org/bot${env.TELEGRAM_BOT_TOKEN}/sendMessage`,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(payload)}).catch(()=>{})}
async function important(env,b,kind,title,text,sub,user){notifyPush(b,{kind,title,text,subscriberKey:sub?.username||sub?.id,customerName:sub?.customerName,user});const topic=(await env.DB.prepare('SELECT value FROM ftth_settings WHERE key=?').bind('log_topic').first())?.value||(await env.DB.prepare('SELECT value FROM ftth_settings WHERE key=?').bind('assistant_topic').first())?.value;await tgSend(env,`✅ ${title}\n${text}`,topic)}
async function powerValue(payload){const direct=Number(payload?.model?.rxPower);if(Number.isFinite(direct))return direct;const exact=['rxpower','rx_power','opticalrxpower','optical_rx_power','receivepower','receivedpower','rxopticalpower','onurxpower','ontrxpower','rxsignal','rx_level','rxlevel'];const num=v=>{if(typeof v==='number'&&Number.isFinite(v))return v;const m=String(v??'').match(/-?\d+(?:\.\d+)?/);return m&&Number.isFinite(Number(m[0]))?Number(m[0]):null};const walk=(v,d=0,path='')=>{if(d>6||v==null)return null;if(Array.isArray(v)){for(const x of v){const n=walk(x,d+1,path);if(n!==null)return n}return null}if(typeof v!=='object')return null;const entries=Object.entries(v);for(const [k,val] of entries){const key=String(k).toLowerCase().replace(/[\s-]/g,'');if(exact.includes(key)){const n=num(val);if(n!==null)return n}}for(const [k,val] of entries){const key=String(k).toLowerCase();if(/rx|receive|received/i.test(key)&&/(power|signal|level)/i.test(key)){const n=num(val);if(n!==null)return n}}let fallback=null;for(const [k,val] of entries){const key=String(k).toLowerCase().replace(/[\s_-]/g,'');if(key==='power'||key==='opticalpower'){const n=num(val);const rxContext=/rx|receive|received|receiver|downstream|onu/i.test(path);if(n!==null&&n<=0&&n>=-60&&(rxContext||fallback===null))fallback=n}}for(const [k,val] of entries){if(val&&typeof val==='object'){const n=walk(val,d+1,path+'/'+String(k).toLowerCase());if(n!==null)return n}}return fallback};return walk(payload)}
async function liveLookup(env,q){const s=clean(q,160),d=digits(s);let path,type;if(d.length>=7&&d.length<=15){type='phone';path=`/customers?pageSize=10&pageNumber=1&sortCriteria.property=self.displayValue&sortCriteria.direction=asc&phone=${encodeURIComponent(d)}`}else if(!/\s/.test(s)&&s.length>=6&&/^[A-Za-z0-9]+$/.test(s)){type='serial';path=`/customers?pageSize=10&pageNumber=1&sortCriteria.property=self.displayValue&sortCriteria.direction=asc&ontSerial=${encodeURIComponent(s)}`}else{type='name';path=`/customers?pageSize=10&pageNumber=1&sortCriteria.property=self.displayValue&sortCriteria.direction=asc&name=${encodeURIComponent(s)}`}const customers=await ftthFetch(env,path),found=Array.isArray(customers?.items)?customers.items.slice(0,5):[];for(const c of found){if(!c?.self?.id)continue;const phones=customerPhones(c),subs=await ftthFetch(env,`/customers/subscriptions?customerId=${encodeURIComponent(c.self.id)}`);await upsertSubs(env,subs?.items||[],{customerId:c.self.id,customerName:c.self.displayValue,phone:phones[0]||'',phone2:phones[1]||''})}return {attempted:true,type,found:found.length}}
const SYS=`إنت مساعد د. كرار داشبورد للإنترنت IQ. احچي باللهجة العراقية البغدادية الطبيعية. جاوب عن الموقع والمشتركين والجباية والتذاكر والمزامنة اعتماداً على السياق المرفق فقط. إذا السؤال إحصائي استخدم الأرقام الموجودة بالسياق ولا تخمّن. إذا سأل عن سبب خلل اذكر السبب المسجل فعلاً، وممنوع تختلق صيانة أو عطل خارجي. لا تكشف أسرار أو توكنات.`;
async function ai(env,q,ctx){const prompt=JSON.stringify(ctx).slice(0,120000);if(env.GROQ_API_KEY){try{const r=await fetch('https://api.groq.com/openai/v1/chat/completions',{method:'POST',headers:{authorization:'Bearer '+env.GROQ_API_KEY,'content-type':'application/json'},body:JSON.stringify({model:env.GROQ_MODEL||'qwen/qwen3.8-27b',messages:[{role:'system',content:SYS},{role:'user',content:`السياق:\n${prompt}\n\nالسؤال: ${q}`}],temperature:.2,max_tokens:1200})});const d=await r.json();const a=clean(d?.choices?.[0]?.message?.content,6000);if(r.ok&&a)return {answer:a,provider:'Qwen'}}catch{}}if(env.GEMINI_API_KEY){const model=env.GEMINI_MODEL||'gemini-3.5-flash-lite';try{const r=await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${model}:generateContent?key=${env.GEMINI_API_KEY}`,{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({systemInstruction:{parts:[{text:SYS}]},contents:[{role:'user',parts:[{text:`السياق:\n${prompt}\n\nالسؤال: ${q}`}]}],generationConfig:{temperature:.2,maxOutputTokens:1200}})});const d=await r.json(),a=clean((d?.candidates?.[0]?.content?.parts||[]).map(x=>x.text||'').join(''),6000);if(r.ok&&a)return {answer:a,provider:'Gemini'}}catch{}}throw Error('AI_UNAVAILABLE')}
async function summaryData(env){const rows=await allSubs(env),b=await business(env),profile=await getSet(env,'profile',null),sync=await syncState(env),t=await getTokenState(env),sum={subscribers:rows.length,active:rows.filter(x=>x.status==='Active').length,expired:rows.filter(x=>x.status==='Expired').length,online:rows.filter(x=>x.hasActiveSession===true).length,offline:rows.filter(x=>x.hasActiveSession===false).length,unknown:rows.filter(x=>x.hasActiveSession===null).length,incomplete:rows.filter(x=>!x.username||!x.zone||!x.fdt||!x.fat).length,zones:new Set(rows.map(x=>x.zone).filter(Boolean)).size,fdts:new Set(rows.map(x=>x.zone+'|'+x.fdt).filter(x=>!x.endsWith('|'))).size,fats:new Set(rows.map(x=>x.zone+'|'+x.fdt+'|'+x.fat).filter(x=>!x.endsWith('|'))).size};let required=0,paid=0,remaining=0,credit=0,collectedToday=0;const today=new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Baghdad'}).format(new Date());for(const a of Object.values(b.accounts||{})){const tt=totals(a);required+=tt.required;paid+=tt.paid;remaining+=tt.remaining;credit+=tt.credit;for(const e of a.entries||[])if(['payment','advance'].includes(e.kind)&&e.at?.startsWith(today))collectedToday+=e.amount}return {...sum,business:{required,paid,remaining,credit,collectedToday,openTickets:(b.tickets||[]).filter(x=>x.status!=='completed').length,pendingOperations:(b.operations||[]).filter(x=>x.status==='waiting_source').length},generatedAt:rows.map(x=>x.sourceUpdatedAt).sort().at(-1)||null,loaded:rows.length>0,live:false,source:{...tokenStatus(t),sync,profile},worker:{configured:true,remote:{version:VERSION,subscriberIndex:{count:rows.length}},version:VERSION},ai:{qwen:!!env.GROQ_API_KEY,gemini:!!env.GEMINI_API_KEY,preferred:'cloud'}}}

async function cloudImport(req,env){
 try{
  const auth=req.headers.get('Authorization')||'';
  if(!env.FTTH_BRIDGE_KEY||await sha(auth)!==await sha('Bearer '+env.FTTH_BRIDGE_KEY))return json({error:'Unauthorized'},401);
  const x=await body(req,4*1024*1024),src=x.sourceCache||{},rows=Array.isArray(src.subscriptions)?src.subscriptions:[];
  if(rows.length>25)return json({error:'Import chunk too large',maxSubscribersPerRequest:25},413);
  if(rows.length){
   const statements=[];
   for(const n0 of rows){
    const n={id:clean(n0.id||n0.subscriptionId||crypto.randomUUID(),80),customerName:clean(n0.customerName,180),username:clean(n0.username,120),zone:clean(n0.zone,120),fdt:clean(n0.fdt,120),fat:clean(n0.fat,120),fdtId:clean(n0.fdtId,100),fatId:clean(n0.fatId,100),status:clean(n0.status,80),expires:clean(n0.expires,80),online:n0.hasActiveSession==null?null:(n0.hasActiveSession?1:0),rxPower:Number.isFinite(n0.rxPower)?n0.rxPower:null,rxAt:clean(n0.rxPowerCheckedAt,80),customerId:clean(n0.customerId,80),subscriptionId:clean(n0.subscriptionId,80),serial:clean(n0.serial,120),ontVendor:clean(n0.ontVendor,120),pointSupplyNumber:clean(n0.pointSupplyNumber,80),phone:clean(n0.phone,40),phone2:clean(n0.phone2,40),ipAddress:clean(n0.ipAddress,80),macAddress:clean(n0.macAddress,80),startedAt:clean(n0.startedAt,80),bundle:clean(n0.bundle,120),sourceUpdatedAt:clean(n0.sourceUpdatedAt,80)||now()};
    statements.push(env.DB.prepare(`INSERT INTO k_subscribers(id,customer_name,username,zone,fdt,fat,fdt_id,fat_id,status,expires,online,rx_power,rx_power_checked_at,customer_id,subscription_id,serial,ont_vendor,point_supply_number,phone,phone2,ip_address,mac_address,started_at,bundle,source_updated_at,raw_json) VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?) ON CONFLICT(id) DO UPDATE SET customer_name=excluded.customer_name,username=excluded.username,zone=excluded.zone,fdt=excluded.fdt,fat=excluded.fat,fdt_id=excluded.fdt_id,fat_id=excluded.fat_id,status=excluded.status,expires=excluded.expires,online=excluded.online,rx_power=excluded.rx_power,rx_power_checked_at=excluded.rx_power_checked_at,customer_id=excluded.customer_id,subscription_id=excluded.subscription_id,serial=excluded.serial,ont_vendor=excluded.ont_vendor,point_supply_number=excluded.point_supply_number,phone=excluded.phone,phone2=excluded.phone2,ip_address=excluded.ip_address,mac_address=excluded.mac_address,started_at=excluded.started_at,bundle=excluded.bundle,source_updated_at=excluded.source_updated_at,raw_json=excluded.raw_json`).bind(n.id,n.customerName,n.username,n.zone,n.fdt,n.fat,n.fdtId,n.fatId,n.status,n.expires,n.online,n.rxPower,n.rxAt,n.customerId,n.subscriptionId,n.serial,n.ontVendor,n.pointSupplyNumber,n.phone,n.phone2,n.ipAddress,n.macAddress,n.startedAt,n.bundle,n.sourceUpdatedAt,JSON.stringify(n0)));
   }
   await env.DB.batch(statements);
  }
  if(src.profile)await setSet(env,'profile',src.profile);
  if(src.sync)await setSet(env,'sync',{...await syncState(env),...src.sync});
  if(x.business&&typeof x.business==='object')await setSet(env,'business',x.business);
  let ftthToken=false;
  if(typeof x.ftthRefreshToken==='string'&&x.ftthRefreshToken.length>40){
   ftthToken=true;
   const rt=x.ftthRefreshToken.trim();
   await saveTokenState(env,{refresh:rt,access:'',accessExp:0,refreshExp:(jwtPayload(rt).exp||0)*1000,lastRefreshAt:null});
   try{await refreshFtth(env,true);await profileFromCurrent(env)}catch{}
  }
  return json({ok:true,importedSubscribers:rows.length,business:!!x.business,ftthToken,version:VERSION});
 }catch(e){
  return json({error:'Cloud import failed',detail:clean(e?.message||e,500),version:VERSION},500);
 }
}
async function apiRoute(req,env,ctx,url){const a=await authRoute(req,env,url);if(a)return a;const st=await sessionUser(req,env);const ad=await adminRoute(req,env,url,st);if(ad)return ad;
 if(url.pathname.startsWith('/api/portal/'))return portalRoute(req,env,url,st);
 if(!url.pathname.startsWith('/api/'))return null;if(!st||!allowed(st))return json({error:'Authentication required'},401);
 if(url.pathname==='/api/health'&&req.method==='GET'){const c=(await env.DB.prepare('SELECT COUNT(*) c FROM k_subscribers').first())?.c||0;return json({ok:true,cloud:true,version:VERSION,records:c,sync:await syncState(env)})}
 if(url.pathname==='/api/summary'&&req.method==='GET')return json(await summaryData(env));
 if(url.pathname==='/api/source/status'&&req.method==='GET'){const t=await getTokenState(env),sync=await syncState(env),profile=await getSet(env,'profile',null),count=(await env.DB.prepare('SELECT COUNT(*) c FROM k_subscribers').first())?.c||0;return json({...tokenStatus(t),sync,profile,cache:{records:count,generatedAt:null}})}
 if(url.pathname==='/api/sync/status'&&req.method==='GET'){if(st.u.role!=='admin')return json({error:'Administrator required'},403);const sync=await syncState(env),profile=await getSet(env,'profile',null),count=(await env.DB.prepare('SELECT COUNT(*) c FROM k_subscribers').first())?.c||0;return json({running:sync.fullState==='running',mode:sync.fullState==='running'?'full':null,page:sync.fullNextPage,records:count,cache:sync,source:tokenStatus(await getTokenState(env)),profile})}
 if(url.pathname==='/api/source/connect'&&req.method==='POST'){if(st.u.role!=='admin')return json({error:'Administrator required'},403);const b=await body(req),token=clean(b.token||b.refreshToken,5000);if(token.length<40)return json({error:'ألصق refresh_token الصحيح.'},400);let ts={refresh:token,access:'',accessExp:0,refreshExp:(jwtPayload(token).exp||0)*1000,lastRefreshAt:null};await saveTokenState(env,ts);try{ts=await refreshFtth(env,true);const profile=await profileFromCurrent(env);let s=await syncState(env);s={...s,fullState:'running',fullNextPage:1,fullProcessedCustomers:0,fullFailedCustomers:0,stopped:false};await saveSync(env,s);ctx.waitUntil(syncOnePage(env,{force:true}).catch(()=>{}));return json({connected:true,profile,source:tokenStatus(ts),fullSync:s})}catch(e){return json({error:e.message},e.status||502)}}
 if(url.pathname==='/api/source/disconnect'&&req.method==='POST'){if(st.u.role!=='admin')return json({error:'Administrator required'},403);await env.DB.prepare('DELETE FROM k_settings WHERE key=?').bind('ftth_token').run();return json({connected:false})}
 if(url.pathname==='/api/source/refresh'&&req.method==='POST'){if(st.u.role!=='admin')return json({error:'Administrator required'},403);try{return json(tokenStatus(await refreshFtth(env,true)))}catch(e){return json({error:e.message},e.status||502)}}
 if(url.pathname==='/api/source/verify'&&req.method==='GET'){if(st.u.role!=='admin')return json({error:'Administrator required'},403);try{const p=await profileFromCurrent(env);return json({connected:true,username:p.username,partnerId:p.partnerId,partnerName:p.partnerName,zones:p.zones})}catch(e){return json({error:e.message},e.status||502)}}
 if(url.pathname==='/api/sync/full'&&req.method==='POST'){if(st.u.role!=='admin')return json({error:'Administrator required'},403);const b=await body(req);let s=await syncState(env);if(b.reset){s={...s,fullState:'running',fullNextPage:1,fullProcessedCustomers:0,fullFailedCustomers:0,fullLastError:null,stopped:false}}else{s={...s,fullState:'running',stopped:false}}await saveSync(env,s);ctx.waitUntil(syncOnePage(env,{force:true}).catch(()=>{}));return json({running:true,mode:'full',page:s.fullNextPage,cache:s,source:tokenStatus(await getTokenState(env)),profile:await getSet(env,'profile',null),records:(await env.DB.prepare('SELECT COUNT(*) c FROM k_subscribers').first())?.c||0})}
 if(url.pathname==='/api/sync/stop'&&req.method==='POST'){if(st.u.role!=='admin')return json({error:'Administrator required'},403);let s=await syncState(env);s={...s,fullState:'paused',stopped:true};await saveSync(env,s);return json(s)}
 if(url.pathname==='/api/integrations/worker/status'&&req.method==='GET'){const count=(await env.DB.prepare('SELECT COUNT(*) c FROM k_subscribers').first())?.c||0;return json({configured:true,syncing:false,remote:{version:VERSION,subscriberIndex:{count,ready:true}},lastError:null})}
 if(url.pathname==='/api/integrations/worker/sync'&&req.method==='POST')return json({ok:true,version:VERSION,cloud:true});
 if(url.pathname==='/api/ai/status'&&req.method==='GET')return json({qwen:!!env.GROQ_API_KEY,gemini:!!env.GEMINI_API_KEY,existingWorker:{configured:true,remote:{version:VERSION}},preferred:'cloud'});
 if(url.pathname==='/api/integrations/telegram/status'&&req.method==='GET')return json({configured:!!env.TELEGRAM_BOT_TOKEN,owner:!!env.FTTH_OWNER_ID,cloud:true});
 if(url.pathname==='/api/search'&&req.method==='GET'){if(!permit(st,'subscribers'))return json({error:'Not permitted'},403);const q=clean(url.searchParams.get('q'),160);let live={attempted:false,type:'none'},err=null;if(q.length>=3){try{live=await liveLookup(env,q)}catch(e){err=e.message;live={attempted:true,type:'error'}}}const like='%'+q.toLowerCase()+'%',page=Math.max(1,Number(url.searchParams.get('page')||1)),ps=40;const all=await env.DB.prepare('SELECT * FROM k_subscribers WHERE lower(customer_name) LIKE ? OR lower(username) LIKE ? OR lower(serial) LIKE ? OR lower(phone) LIKE ? OR lower(phone2) LIKE ? ORDER BY customer_name LIMIT ? OFFSET ?').bind(like,like,like,like,like,ps,(page-1)*ps).all(),cnt=(await env.DB.prepare('SELECT COUNT(*) c FROM k_subscribers WHERE lower(customer_name) LIKE ? OR lower(username) LIKE ? OR lower(serial) LIKE ? OR lower(phone) LIKE ? OR lower(phone2) LIKE ?').bind(like,like,like,like,like).first())?.c||0;return json({items:(all.results||[]).map(rowSub),total:cnt,page,pages:Math.max(1,Math.ceil(cnt/ps)),live:{...live,error:err},source:tokenStatus(await getTokenState(env))})}
 if(url.pathname==='/api/browse'&&req.method==='GET'){let rows=await allSubs(env);for(const k of ['zone','fdt','fat'])if(url.searchParams.has(k)){const wanted=clean(url.searchParams.get(k),120);rows=rows.filter(x=>clean(x[k],120)===wanted)}const q=clean(url.searchParams.get('q'),200).toLowerCase();if(q)rows=rows.filter(x=>[x.customerName,x.username,x.serial,x.phone].some(v=>String(v||'').toLowerCase().includes(q)));const f=url.searchParams.get('status');if(f==='online')rows=rows.filter(x=>x.hasActiveSession===true);if(f==='offline')rows=rows.filter(x=>x.hasActiveSession===false);if(f==='expired')rows=rows.filter(x=>x.status==='Expired');const group=url.searchParams.get('group');if(['zone','fdt','fat'].includes(group)){const m=new Map();for(const x of rows){const key=group==='fat'?JSON.stringify([x.zone,x.fdt,x.fat]):x[group];if(!m.has(key))m.set(key,[]);m.get(key).push(x)}return json({groups:[...m].map(([name,list])=>({name:group==='fat'?list[0].fat:name,scope:group==='fat'?[list[0].zone,list[0].fdt,list[0].fat]:null,subscribers:list.length,active:list.filter(x=>x.status==='Active').length,expired:list.filter(x=>x.status==='Expired').length,online:list.filter(x=>x.hasActiveSession===true).length,offline:list.filter(x=>x.hasActiveSession===false).length})).sort((a,b)=>String(a.name).localeCompare(String(b.name),undefined,{numeric:true})),total:rows.length})}const page=Math.max(1,Number(url.searchParams.get('page')||1));return json({items:rows.slice((page-1)*40,page*40),total:rows.length,page,pages:Math.max(1,Math.ceil(rows.length/40))})}
 if(url.pathname==='/api/power'&&req.method==='GET'){if(!permit(st,'subscribers'))return json({error:'Not permitted'},403);const r=await env.DB.prepare('SELECT * FROM k_subscribers WHERE id=?').bind(url.searchParams.get('id')||'').first();if(!r)return json({error:'Not found'},404);try{const raw=await ftthFetch(env,`/subscriptions/device/ont?username=${encodeURIComponent(r.username)}`,{timeout:60000}),p=await powerValue(raw),at=now();if(!Number.isFinite(p))return json({error:'FTTH لم يرجع قراءة باور حالية.',connected:false,live:false,rxPower:null,checkedAt:null},502);await env.DB.prepare('UPDATE k_subscribers SET rx_power=?,rx_power_checked_at=? WHERE id=?').bind(p,at,r.id).run();return json({connected:true,rxPower:p,checkedAt:at,live:true})}catch(e){return json({error:e.message,connected:false,live:false,rxPower:null,checkedAt:null},e.status||502)}}
 if(url.pathname==='/api/power/batch-stream'&&req.method==='GET'){if(!permit(st,'subscribers'))return json({error:'Not permitted'},403);const ids=clean(url.searchParams.get('ids'),4000).split(',').filter(Boolean).slice(0,16),rows=[];for(const id of ids){const r=await env.DB.prepare('SELECT * FROM k_subscribers WHERE id=?').bind(id).first();if(r)rows.push(r)}const stream=new ReadableStream({start(controller){Promise.allSettled(rows.map(async r=>{try{const raw=await ftthFetch(env,`/subscriptions/device/ont?username=${encodeURIComponent(r.username)}`,{timeout:60000}),p=await powerValue(raw),at=now();if(!Number.isFinite(p)){controller.enqueue(enc.encode(JSON.stringify({id:r.id,ok:false,error:'FTTH لم يرجع قراءة باور حالية',rxPower:null,checkedAt:null})+'\n'));return}await env.DB.prepare('UPDATE k_subscribers SET rx_power=?,rx_power_checked_at=? WHERE id=?').bind(p,at,r.id).run();controller.enqueue(enc.encode(JSON.stringify({id:r.id,ok:true,live:true,rxPower:p,checkedAt:at})+'\n'))}catch(e){controller.enqueue(enc.encode(JSON.stringify({id:r.id,ok:false,error:e.message,rxPower:null,checkedAt:null})+'\n'))}})).finally(()=>controller.close())}});return new Response(stream,{headers:{'content-type':'application/x-ndjson','cache-control':'no-store'}})}
 if(url.pathname==='/api/network/column-options'&&req.method==='GET'){const rows=await env.DB.prepare('SELECT DISTINCT fdt_id,fat_id,fdt,fat,zone FROM k_subscribers WHERE fdt_id<>\'\' AND fat_id<>\'\' ORDER BY zone,fdt,fat').all();return json({items:(rows.results||[]).map(x=>({fdtId:x.fdt_id,fatId:x.fat_id,fdt:x.fdt,fat:x.fat,zone:x.zone}))})}
 if(url.pathname==='/api/source/change-password'&&req.method==='POST')return changeDevice(req,env,st,'password');
 if(url.pathname==='/api/source/change-serial'&&req.method==='POST')return changeDevice(req,env,st,'serial');
 if(url.pathname==='/api/source/change-column'&&req.method==='POST')return changeDevice(req,env,st,'column');
 if(url.pathname==='/api/source/tickets'&&req.method==='GET'){try{return json(await ftthFetch(env,`/support/tickets?pageSize=${Math.min(50,Number(url.searchParams.get('pageSize')||12))}&pageNumber=${Math.max(1,Number(url.searchParams.get('page')||1))}&sortCriteria.property=createdAt&sortCriteria.direction=desc&hierarchyLevel=0&additionalFilter=ForMe`))}catch(e){return json({error:e.message},e.status||502)}}
 if(url.pathname==='/api/source/customer-tickets'&&req.method==='GET'){const id=digits(url.searchParams.get('customerId'));if(!id)return json({error:'Customer ID required'},400);const cached=await env.DB.prepare('SELECT * FROM k_customer_tickets WHERE customer_id=?').bind(id).first();try{const p=await ftthFetch(env,`/support/tickets?pageSize=${Math.min(100,Number(url.searchParams.get('pageSize')||50))}&pageNumber=${Math.max(1,Number(url.searchParams.get('page')||1))}&sortCriteria.property=UpdatedAt&sortCriteria.direction=desc&customerId=${encodeURIComponent(id)}&additionalFilter=ForMe`);await env.DB.prepare('INSERT INTO k_customer_tickets(customer_id,payload_json,updated_at) VALUES(?,?,?) ON CONFLICT(customer_id) DO UPDATE SET payload_json=excluded.payload_json,updated_at=excluded.updated_at').bind(id,JSON.stringify(p),now()).run();return json({payload:p,cached:false,updatedAt:now()})}catch(e){if(cached)return json({payload:JSON.parse(cached.payload_json),cached:true,updatedAt:cached.updated_at,error:e.message});return json({error:e.message},e.status||502)}}
 if(url.pathname==='/api/cabinet-layout'&&req.method==='GET'){const b=await business(env);return json({layout:b.cabinetLayouts?.[clean(url.searchParams.get('cabinetKey'),300)]||{}})}
 if(url.pathname==='/api/cabinet-layout'&&req.method==='POST'){const x=await body(req),b=await business(env),ck=clean(x.cabinetKey,300),sk=clean(x.subscriberKey,180),port=Number(x.port);if(!ck||!sk||!Number.isInteger(port)||port<1||port>16)return json({error:'Invalid layout'},400);const lay={...(b.cabinetLayouts[ck]||{})};for(const [k,v] of Object.entries(lay))if(Number(v)===port&&k!==sk)delete lay[k];lay[sk]=port;b.cabinetLayouts[ck]=lay;await saveBusiness(env,b);return json({layout:lay})}
 if(url.pathname.startsWith('/api/finance'))return financeRoute(req,env,url,st);
 if(url.pathname.startsWith('/api/maintenance'))return maintenanceRoute(req,env,url,st);
 if(url.pathname==='/api/operations'&&req.method==='POST'){if(!permit(st,'manageSubscriber'))return json({error:'Not permitted'},403);const x=await body(req),allowedOps=new Set(['change_serial','change_fat','change_column','transfer','request_activation']);if(!allowedOps.has(x.action))return json({error:'Invalid operation'},400);const b=await business(env),op={id:crypto.randomUUID(),at:now(),subscriberKey:clean(x.subscriberKey,180),customerName:clean(x.customerName,160),action:clean(x.action,60),value:clean(x.value,200),reason:clean(x.reason,500),status:'waiting_source',userId:st.u.id,userName:st.u.name};b.operations.push(op);b.operations=b.operations.slice(-2000);await saveBusiness(env,b);return json({operation:op,source:tokenStatus(await getTokenState(env))},201)}
 if(url.pathname==='/api/operations'&&req.method==='GET'){const b=await business(env),id=clean(url.searchParams.get('id'),180);return json({items:(b.operations||[]).filter(x=>!id||x.subscriberKey===id).slice(-100).reverse(),source:tokenStatus(await getTokenState(env))})}
 if(url.pathname==='/api/notifications'&&req.method==='GET'){const b=await business(env),imp=new Set(['finance','change_password','change_serial','change_column','admin_password','maintenance_completed','source_error']);return json({items:(b.notifications||[]).filter(x=>imp.has(x.kind)).slice(-Math.min(300,Number(url.searchParams.get('limit')||100))).reverse()})}
 if(url.pathname==='/api/locations'&&req.method==='GET'){const b=await business(env),q=clean(url.searchParams.get('q'),120).toLowerCase(),all=Object.values(b.locations||{}).filter(x=>!q||JSON.stringify(x).toLowerCase().includes(q)),page=Math.max(1,Number(url.searchParams.get('page')||1)),ps=Math.min(100,Number(url.searchParams.get('pageSize')||25));return json({items:all.slice((page-1)*ps,page*ps),total:all.length,page,pages:Math.max(1,Math.ceil(all.length/ps))})}
 if(url.pathname==='/api/location'&&req.method==='GET'){const b=await business(env);return json({location:b.locations?.[clean(url.searchParams.get('id'),180)]||null})}
 if(url.pathname==='/api/location'&&req.method==='POST'){const x=await body(req),b=await business(env),id=clean(x.subscriberKey||x.id,180);if(!id)return json({error:'Subscriber required'},400);b.locations[id]={...x,id,updatedAt:now()};await saveBusiness(env,b);return json({location:b.locations[id]})}
 if(url.pathname.startsWith('/api/chat'))return chatRoute(req,env,url,st);
 if(url.pathname==='/api/reports/daily'&&req.method==='GET')return dailyReport(env,url.searchParams.get('date'));
 return json({error:'Not found'},404)}
async function changeDevice(req,env,st,type){if(!permit(st,'manageSubscriber'))return json({error:'Not permitted'},403);const x=await body(req),id=clean(x.subscriptionId,80),sub=await env.DB.prepare('SELECT * FROM k_subscribers WHERE id=? OR subscription_id=?').bind(id,id).first();if(!id)return json({error:'معرّف الاشتراك غير متوفر.'},400);try{let payload,title,kind,value,prev='';if(type==='password'){const pass=String(x.password||'');if(!pass)return json({error:'أدخل الباسورد الجديد.'},400);await ftthFetch(env,`/subscriptions/validate-password?password=${encodeURIComponent(pass)}`);payload={devicePassword:pass};title='تم تغيير الباسوورد';kind='change_password';value='••••'}else if(type==='serial'){value=clean(x.serial,64).toUpperCase();prev=sub?.serial||'';payload={ontSerial:value};title='تم تغيير السيريال';kind='change_serial'}else{payload={fat:clean(x.fat,80),fdt:clean(x.fdt,80)};prev=[sub?.fdt,sub?.fat].filter(Boolean).join(' / ');value=[x.fdtLabel||'',x.fatLabel||''].filter(Boolean).join(' / ')||payload.fat;title='تم تغيير العمود';kind='change_column'}await ftthFetch(env,`/subscriptions/${encodeURIComponent(id)}/device`,{method:'PUT',json:payload});const b=await business(env),op={id:crypto.randomUUID(),at:now(),subscriberKey:clean(x.subscriberKey||sub?.username||id,180),customerName:clean(x.customerName||sub?.customer_name,160),action:kind.replace('change_','change_'),value,previousValue:prev,reason:clean(x.reason,500),status:'executed',userId:st.u.id,userName:st.u.name};b.operations.push(op);if(type==='serial'&&sub)await env.DB.prepare('UPDATE k_subscribers SET serial=? WHERE id=?').bind(value,sub.id).run();await important(env,b,kind,title,`${sub?.customer_name||x.customerName||'المشترك'} — ${type==='password'?'تم الحفظ بنجاح':`${prev||'—'} ← ${value||'—'}`}`,sub?rowSub(sub):null,st.u);await saveBusiness(env,b);return json({ok:true,operation:op})}catch(e){return json({error:e.message},e.status||502)}}
async function financeRoute(req,env,url,st){if(!permit(st,'finance'))return json({error:'Not permitted'},403);const b=await business(env);if(url.pathname==='/api/finance/entry'&&req.method==='POST'){const x=await body(req),kind=clean(x.kind,40),amount=Number(x.amount);if(!['charge','payment','advance','discount','correction_plus','correction_minus'].includes(kind)||!Number.isFinite(amount)||amount<=0)return json({error:'Invalid finance entry'},400);const a=accOf(b,x.subscriberKey,x.customerName),sign=['charge','correction_plus'].includes(kind)?1:-1,e={id:crypto.randomUUID(),at:now(),kind,amount,delta:sign*amount,note:clean(x.note,500),userId:st.u.id,userName:st.u.name};a.entries.push(e);await important(env,b,'finance','اكتملت حركة مالية',`تم تسجيل ${amount.toLocaleString('ar-IQ')} د.ع للمشترك ${a.customerName||a.subscriberKey}.`,{username:a.subscriberKey,customerName:a.customerName},st.u);await saveBusiness(env,b);return json({account:{...a,entries:[...a.entries].reverse(),totals:totals(a)}})}if(url.pathname==='/api/finance'&&req.method==='GET'){const a=accOf(b,url.searchParams.get('id'),url.searchParams.get('name'));return json({account:{...a,entries:[...a.entries].reverse(),totals:totals(a)}})}if(url.pathname==='/api/finance/accounts'&&req.method==='GET'){const q=clean(url.searchParams.get('q'),120).toLowerCase(),debts=url.searchParams.get('debtsOnly')==='1',page=Math.max(1,Number(url.searchParams.get('page')||1)),ps=Math.min(100,Number(url.searchParams.get('pageSize')||30));let rows=Object.values(b.accounts||{}).map(a=>({...a,entries:undefined,totals:totals(a),lastEntry:a.entries?.at?.(-1)||a.entries?.[a.entries.length-1]||null}));if(q)rows=rows.filter(a=>[a.customerName,a.subscriberKey].some(v=>String(v||'').toLowerCase().includes(q)));if(debts)rows=rows.filter(a=>a.totals.remaining>0);return json({items:rows.slice((page-1)*ps,page*ps),total:rows.length,page,pages:Math.max(1,Math.ceil(rows.length/ps))})}return json({error:'Not found'},404)}
async function maintenanceRoute(req,env,url,st){if(!permit(st,'maintenance'))return json({error:'Not permitted'},403);const b=await business(env);if(url.pathname==='/api/maintenance'&&req.method==='GET'){const id=clean(url.searchParams.get('id'),180);return json({items:(b.tickets||[]).filter(x=>!id||x.subscriberKey===id).slice(-100).reverse()})}if(url.pathname==='/api/maintenance'&&req.method==='POST'){const x=await body(req);if(!clean(x.subject,180))return json({error:'Subject required'},400);const t={id:crypto.randomUUID(),createdAt:now(),updatedAt:now(),subscriberKey:clean(x.subscriberKey,180),customerName:clean(x.customerName,160),subject:clean(x.subject,180),note:clean(x.note,1000),visitAt:clean(x.visitAt,40)||null,status:'new',userId:st.u.id,userName:st.u.name};b.tickets.push(t);await saveBusiness(env,b);return json({ticket:t},201)}if(url.pathname==='/api/maintenance/update'&&req.method==='POST'){const x=await body(req),t=b.tickets.find(y=>y.id===x.id);if(!t)return json({error:'Ticket not found'},404);if(!['new','following','visit','completed'].includes(x.status))return json({error:'Invalid ticket status'},400);t.status=x.status;t.updatedAt=now();if(x.note!==undefined)t.note=clean(x.note,1000);if(x.visitAt!==undefined)t.visitAt=clean(x.visitAt,40)||null;if(x.status==='completed'){t.completedAt=now();await important(env,b,'maintenance_completed','اكتملت الصيانة',`${t.customerName||t.subscriberKey}: ${t.subject}`,{username:t.subscriberKey,customerName:t.customerName},st.u)}await saveBusiness(env,b);return json({ticket:t})}return json({error:'Not found'},404)}
async function dailyReport(env,date){const b=await business(env),day=clean(date,10)||new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Baghdad'}).format(new Date()),entries=[];for(const a of Object.values(b.accounts||{}))for(const e of a.entries||[])if(e.at?.startsWith(day))entries.push({...e,subscriberKey:a.subscriberKey,customerName:a.customerName});return json({date:day,generatedAt:now(),collected:entries.filter(e=>['payment','advance'].includes(e.kind)).reduce((n,e)=>n+e.amount,0),charged:entries.filter(e=>['charge','correction_plus'].includes(e.kind)).reduce((n,e)=>n+e.amount,0),discounts:entries.filter(e=>['discount','correction_minus'].includes(e.kind)).reduce((n,e)=>n+e.amount,0),entries:entries.sort((a,b)=>b.at.localeCompare(a.at)).slice(0,200),ticketsCreated:(b.tickets||[]).filter(x=>x.createdAt?.startsWith(day)),ticketsCompleted:(b.tickets||[]).filter(x=>x.completedAt?.startsWith(day)),operationsQueued:(b.operations||[]).filter(x=>x.at?.startsWith(day)),openTickets:(b.tickets||[]).filter(x=>x.status!=='completed').length,pendingOperations:(b.operations||[]).filter(x=>x.status==='waiting_source').length})}
async function chatContext(env,q,subscriberKey){const rows=await allSubs(env),b=await business(env),sync=await syncState(env),profile=await getSet(env,'profile',null),tokens=[...new Set(clean(q,1200).toLowerCase().split(/[^\p{L}\p{N}_.@+-]+/u).filter(x=>x.length>=3))].slice(0,8),facts=[];for(const term of tokens){const low=term.toLowerCase(),matches=rows.filter(x=>[x.customerName,x.username,x.phone,x.phone2,x.serial,x.zone,x.fdt,x.fat].some(v=>String(v||'').toLowerCase().includes(low)));facts.push({term,count:matches.length,samples:matches.slice(0,8).map(x=>({name:x.customerName,username:x.username,zone:x.zone,fat:x.fat}))})}let focus=null;if(subscriberKey){const s=rows.find(x=>[x.id,x.username,x.subscriptionId,x.customerId].includes(subscriberKey));if(s){const a=b.accounts?.[subscriberKey]||{subscriberKey,customerName:s.customerName,entries:[]};focus={subscriber:s,finance:{...a,totals:totals(a)},operations:(b.operations||[]).filter(x=>x.subscriberKey===subscriberKey).slice(-50),maintenance:(b.tickets||[]).filter(x=>x.subscriberKey===subscriberKey).slice(-50)}}}return {workspace:'د. كرار داشبورد للإنترنت IQ',version:VERSION,siteHealth:{records:rows.length,source:tokenStatus(await getTokenState(env)),sync,profile},keywordFacts:facts,business:{notifications:(b.notifications||[]).slice(-30),operations:(b.operations||[]).slice(-30),maintenance:(b.tickets||[]).slice(-20)},subscriberFocus:focus}}
async function chatRoute(req,env,url,st){if(!permit(st,'ai'))return json({error:'Not permitted'},403);if(url.pathname==='/api/chat/dates'&&req.method==='GET'){const scope=url.searchParams.get('subscriberKey')?'subscriber:'+url.searchParams.get('subscriberKey'):'global',r=await env.DB.prepare('SELECT DISTINCT substr(created_at,1,10) d FROM k_chat WHERE scope=? AND user_id=? ORDER BY d DESC LIMIT 100').bind(scope,st.u.id).all();return json({dates:(r.results||[]).map(x=>x.d)})}if(url.pathname==='/api/chat/history'&&req.method==='GET'){const scope=url.searchParams.get('subscriberKey')?'subscriber:'+url.searchParams.get('subscriberKey'):'global',date=clean(url.searchParams.get('date'),10),clear=await getSet(env,`chat_clear:${st.u.id}:${scope}`,null);let sql='SELECT * FROM k_chat WHERE scope=? AND user_id=?',bind=[scope,st.u.id];if(date){sql+=' AND substr(created_at,1,10)=?';bind.push(date)}else if(clear){sql+=' AND created_at>?';bind.push(clear)}sql+=' ORDER BY created_at ASC LIMIT 400';const r=await env.DB.prepare(sql).bind(...bind).all();return json({turns:(r.results||[]).map(x=>({question:x.question,answer:x.answer,provider:x.provider,created_at:x.created_at})),clearedAt:clear,connected:true,source:'cloud'})}if(url.pathname==='/api/chat/clear'&&req.method==='POST'){const x=await body(req),scope=x.subscriberKey?'subscriber:'+clean(x.subscriberKey,180):'global',at=now();await setSet(env,`chat_clear:${st.u.id}:${scope}`,at);return json({ok:true,clearedAt:at})}if(url.pathname==='/api/chat'&&req.method==='POST'){const x=await body(req),q=clean(x.question,1500);if(!q)return json({error:'اكتب سؤالك أولاً.'},400);const sk=clean(x.subscriberKey,180),scope=sk?'subscriber:'+sk:'global',ctx=await chatContext(env,q,sk);try{const r=await ai(env,q,ctx);await env.DB.prepare('INSERT INTO k_chat(id,scope,user_id,user_name,question,answer,provider,created_at) VALUES(?,?,?,?,?,?,?,?)').bind(crypto.randomUUID(),scope,st.u.id,st.u.name,q,r.answer,r.provider,now()).run();return json(r)}catch{return json({error:'تعذر الحصول على رد الآن.'},502)}}return json({error:'Not found'},404)}
async function portalRoute(req,env,url,st){const pc=()=>cookie(req,'karrar_portal');const resolve=async()=>{const raw=pc();if(!raw)return null;const s=await env.DB.prepare('SELECT * FROM k_portal_sessions WHERE token_hash=?').bind(await sha(raw)).first();if(!s||s.expires_at<Date.now())return null;return s};if(url.pathname==='/api/portal/login'&&req.method==='POST'){const x=await body(req),phone=digits(x.phone),code=String(x.code||'').trim(),a=await env.DB.prepare('SELECT * FROM k_portal_accounts WHERE phone=? AND enabled=1').bind(phone).first();if(!a||!/^[0-9]{6}$/.test(code)||!(await verifyPass(code,a.salt,a.digest)))return json({error:'رقم الهاتف أو رمز الدخول غير صحيح.'},401);const raw=b64u(crypto.getRandomValues(new Uint8Array(32)));await env.DB.prepare('INSERT INTO k_portal_sessions(token_hash,subscriber_key,expires_at) VALUES(?,?,?)').bind(await sha(raw),a.subscriber_key,Date.now()+7*24*3600e3).run();return withCookie(json({ok:true}),'karrar_portal',raw,7*24*3600,'Lax')}
 if(url.pathname==='/api/portal/logout'&&req.method==='POST'){const raw=pc();if(raw)await env.DB.prepare('DELETE FROM k_portal_sessions WHERE token_hash=?').bind(await sha(raw)).run();return withCookie(json({ok:true}),'karrar_portal','',0,'Lax')}
 if(url.pathname==='/api/portal/admin/create-code'&&req.method==='POST'){if(!(st?.u.role==='admin'||permit(st,'manageSubscriber')))return json({error:'Not permitted'},403);const x=await body(req),sk=clean(x.subscriberKey,180),phone=digits(x.phone);if(!sk||phone.length<10)return json({error:'Valid subscriber and phone required'},400);const code=String(Math.floor(100000+Math.random()*900000)),hp=await makePass(code);await env.DB.prepare('INSERT INTO k_portal_accounts(subscriber_key,phone,salt,digest,enabled,updated_at) VALUES(?,?,?,?,1,?) ON CONFLICT(subscriber_key) DO UPDATE SET phone=excluded.phone,salt=excluded.salt,digest=excluded.digest,enabled=1,updated_at=excluded.updated_at').bind(sk,phone,hp.salt,hp.digest,now()).run();return json({access:{subscriberKey:sk,phone,code,updatedAt:now()}})}
 if(url.pathname==='/api/portal/admin/status'&&req.method==='GET'){if(!(st?.u.role==='admin'||permit(st,'manageSubscriber')))return json({error:'Not permitted'},403);const a=await env.DB.prepare('SELECT phone,enabled,updated_at FROM k_portal_accounts WHERE subscriber_key=?').bind(clean(url.searchParams.get('subscriberKey'),180)).first();return json({access:a?{phone:a.phone,enabled:!!a.enabled,updatedAt:a.updated_at}:null})}
 const ps=await resolve();if(!ps)return json({error:'يلزم تسجيل الدخول إلى بوابة المشترك.'},401);const r=await env.DB.prepare('SELECT * FROM k_subscribers WHERE id=? OR username=? OR subscription_id=? OR customer_id=? LIMIT 1').bind(ps.subscriber_key,ps.subscriber_key,ps.subscriber_key,ps.subscriber_key).first();if(!r)return json({error:'بيانات الاشتراك غير متوفرة حالياً.'},404);const sub=rowSub(r),b=await business(env),a=accOf(b,ps.subscriber_key,sub.customerName);
 if(url.pathname==='/api/portal/me'&&req.method==='GET')return json({subscriber:{customerName:sub.customerName,username:sub.username,status:sub.status,expires:sub.expires,bundle:sub.bundle,online:sub.hasActiveSession===true,phone:sub.phone,zone:sub.zone},finance:{totals:totals(a),lastPayment:totals(a).lastPayment},maintenance:(b.tickets||[]).filter(x=>x.subscriberKey===ps.subscriber_key).slice(-20).reverse()});
 if(url.pathname==='/api/portal/maintenance'&&req.method==='POST'){const x=await body(req),t={id:crypto.randomUUID(),createdAt:now(),updatedAt:now(),subscriberKey:ps.subscriber_key,customerName:sub.customerName,subject:clean(x.subject,180),note:clean(x.note,1000),status:'new',userId:'subscriber-portal',userName:'بوابة المشترك'};if(!t.subject)return json({error:'Subject required'},400);b.tickets.push(t);await saveBusiness(env,b);return json({ticket:t},201)}
 if(url.pathname==='/api/portal/chat'&&req.method==='POST'){const x=await body(req),q=clean(x.question,1200);try{return json(await ai(env,q,await chatContext(env,q,ps.subscriber_key)))}catch{return json({error:'تعذر الحصول على رد الآن.'},502)}}return json({error:'Not found'},404)}
async function telegram(req,env){if(!env.TELEGRAM_BOT_TOKEN||!env.FTTH_OWNER_ID)return new Response('OK');if(env.FTTH_WEBHOOK_SECRET&&req.headers.get('X-Telegram-Bot-Api-Secret-Token')!==env.FTTH_WEBHOOK_SECRET)return json({error:'Unauthorized'},401);const u=await req.json(),m=u.message||u.edited_message;if(!m||String(m.chat?.id)!==String(env.FTTH_OWNER_ID)||String(m.from?.id)!==String(env.FTTH_OWNER_ID)||m.from?.is_bot)return new Response('OK');const text=clean(m.text,1500);if(!text)return new Response('OK');const pm=text.match(/^(?:سوي|خلي|غير|غيّر|بدل)\s+(?:باسورد|الباسورد|كلمة\s+المرور)(?:\s+(?:مال\s+)?الموقع)?\s+(?:يصير\s+)?(.{5,128})$/i);if(pm){try{await setAdminPassword(env,pm[1].trim(),{id:'telegram-owner',name:'مالك البوت',role:'admin'});await tgSend(env,'✅ تم تغيير باسورد الموقع وصار جاهز للدخول.',m.message_thread_id)}catch(e){await tgSend(env,'❌ '+e.message,m.message_thread_id)}return new Response('OK')}try{const r=await ai(env,text,await chatContext(env,text,''));await tgSend(env,`${r.provider}\n${r.answer}`,m.message_thread_id)}catch{await tgSend(env,'تعذر الحصول على جواب هسه، جرّب بعد شوي.',m.message_thread_id)}return new Response('OK')}
async function scheduled(env){await init(env);try{await refreshFtth(env)}catch{}try{await syncOnePage(env)}catch(e){const b=await business(env);notifyPush(b,{kind:'source_error',title:'تعذر تحديث FTTH',text:clean(e.message,300)});await saveBusiness(env,b)}}
async function staticResponse(req,env){
 const url=new URL(req.url);
 if(!['GET','HEAD'].includes(req.method)||url.pathname.startsWith('/api/')||['/healthz','/telegram'].includes(url.pathname))return null;
 if(!env.ASSETS)return null;
 const path=url.pathname.replace(/\/+$/,'')||'/';
 if(path==='/subscriber'||path==='/subscriber.html')url.pathname='/subscriber.html';
 else if(!/\.[^/]+$/.test(path)||path==='/index.html')url.pathname='/index.html';
 const response=await env.ASSETS.fetch(new Request(url,req));
 const headers=new Headers(response.headers);
 if((headers.get('content-type')||'').includes('text/html')){headers.set('content-type','text/html; charset=utf-8');headers.set('cache-control','no-store')}
 return new Response(response.body,{status:response.status,headers});
}
async function fetchHandler(req,env,ctx){try{const asset=await staticResponse(req,env);if(asset)return asset;await init(env);const url=new URL(req.url);if(url.pathname==='/api/cloud/import'&&req.method==='POST')return cloudImport(req,env);if(url.pathname==='/api/source/access-token-sync'&&req.method==='POST')return accessTokenSync(req,env);if(url.pathname==='/telegram'&&req.method==='POST')return telegram(req,env);if(url.pathname==='/healthz')return json({ok:true,version:VERSION,cloud:true});const r=await apiRoute(req,env,ctx,url);if(r)return r;if(req.method==='GET'&&url.pathname==='/subscriber')return Response.redirect(new URL('/subscriber.html',url),302);return json({error:'Not found'},404)}catch(e){return json({error:'Worker request failed',detail:clean(e?.message||e,500),version:VERSION},500)}}
export default {fetch:fetchHandler,scheduled:(_c,env,ctx)=>ctx.waitUntil(scheduled(env))};
